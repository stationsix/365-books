---
import Base from '../layouts/Base.astro';
import VerdictBar from '../components/VerdictBar.astro';
import VerdictLegend from '../components/VerdictLegend.astro';
import ProgressGrid from '../components/ProgressGrid.astro';
import { getLiveBooks, sumTags, themeName, themes, verdictStats } from '../lib/books';
import { url } from '../lib/url';

const books = await getLiveBooks();
const totals = sumTags(books);
const { total, pct } = verdictStats(totals);
const verdicts = [
  { key: 'transcends', label: 'Transcend' },
  { key: 'evolves', label: 'Evolve' },
  { key: 'expires', label: 'Expire' },
] as const;
const themeCounts = themes.map((t) => ({
  ...t,
  done: books.filter((b) => b.data.theme === t.slug).length,
}));
---

<Base>
  <div class="container">
    <section class="hero">
      <p class="label">Business books for the AI era</p>
      <h1>365 essential business books, each turned into prompts for your AI.</h1>
      <p class="lead">
        Get a book's core ideas in minutes, then copy a prompt into your AI assistant to apply them
        to your own team, plan or decision. Every key concept is tagged for the AI era:
      </p>
      <p class="hero__tags">
        <span class="tag tag--transcends">Transcends</span>
        <span class="tag tag--evolves">Evolves</span>
        <span class="tag tag--expires">Expires</span>
      </p>
      <div class="hero__actions">
        <a class="btn" href="#library">Read the latest</a>
        <a class="btn btn--outline" href={url('/how-its-made/')}>How it's made</a>
      </div>
    </section>

    <section class="section" id="scoreboard" aria-labelledby="scoreboard-title">
      <h2 class="section-header" id="scoreboard-title"><span class="num">01</span> / Scoreboard</h2>
      <div class="panel scoreboard">
        <div class="scoreboard__nums">
          {verdicts.map((v) => (
            <div class={`score score--${v.key}`}>
              <p class="score__num">{totals[v.key]}</p>
              <p class="label score__label"><span>{v.label}</span><span class="score__pct">{pct[v.key]}%</span></p>
            </div>
          ))}
        </div>
        <VerdictBar tags={totals} height={14} />
        <p class="scoreboard__note">
          {total} key concepts across {books.length} verified {books.length === 1 ? 'summary' : 'summaries'}.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="progress-title">
      <h2 class="section-header" id="progress-title"><span class="num">02</span> / Progress to 365</h2>
      <ProgressGrid books={books} />
    </section>

    <section class="section" id="library" aria-labelledby="library-title">
      <h2 class="section-header" id="library-title"><span class="num">03</span> / Latest summaries</h2>
      <ul class="library">
        {books.map((b) => (
          <li>
            <a class="book-row" href={url(`/books/${b.id}/`)}>
              <span class="book-row__meta label">{themeName(b.data.theme)} · {b.data.year}</span>
              <span class="book-row__title">{b.data.title}</span>
              <span class="book-row__author">{b.data.author}</span>
              <span class="book-row__verdict">
                <VerdictBar tags={b.data.tags} height={6} gap={2} />
                <VerdictLegend tags={b.data.tags} compact />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="themes" aria-labelledby="themes-title">
      <h2 class="section-header" id="themes-title"><span class="num">04</span> / 12 themes</h2>
      <ol class="themes">
        {themeCounts.map((t, i) => (
          <li class="theme">
            <span class="theme__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="theme__name">{t.name}</span>
            <span class="theme__count">{t.done}/{t.target}</span>
            <span class="theme__bar" aria-hidden="true">
              <span style={`width:${Math.min(100, (t.done / t.target) * 100)}%`}></span>
            </span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  .hero { padding-top: 72px; max-width: 900px; }
  .hero h1 { margin-top: 16px; }
  .hero .lead { margin: 24px 0 0; max-width: 760px; color: var(--text); }
  .hero__tags { display: flex; gap: 8px; flex-wrap: wrap; margin: 24px 0 0; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .num { color: var(--text); }

  .scoreboard { display: grid; gap: 20px; padding: 28px; }
  .scoreboard__nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .score p { margin: 0; }
  .score__num { font-family: var(--font-mono); font-size: 56px; font-weight: 600; line-height: 1; margin-bottom: 8px !important; }
  .score--transcends .score__num { color: var(--transcends); }
  .score--evolves .score__num { color: var(--evolves); }
  .score--expires .score__num { color: var(--expires); }
  .score__label { display: flex; flex-wrap: wrap; gap: 0 8px; }
  .score__pct { color: var(--text); }
  .scoreboard__note { margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--muted); }

  .library { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .library li { border-bottom: 1px solid var(--line); }
  .book-row {
    display: grid;
    grid-template-columns: 1fr 260px;
    grid-template-areas: 'meta verdict' 'title verdict' 'author verdict';
    gap: 2px 32px;
    align-items: center;
    padding: 20px 0;
    color: var(--text);
    text-decoration: none;
  }
  .book-row:hover .book-row__title { color: var(--brand-hover); }
  .book-row__meta { grid-area: meta; }
  .book-row__title { grid-area: title; font-size: 22px; font-weight: 600; line-height: 1.3; }
  .book-row__author { grid-area: author; color: var(--muted); }
  .book-row__verdict { grid-area: verdict; display: grid; gap: 8px; }

  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .theme {
    background: var(--bg);
    padding: 16px 18px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 4px 12px;
    align-items: baseline;
  }
  .theme__num, .theme__count { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .theme__name { font-weight: 500; }
  .theme__bar { grid-column: 1 / -1; height: 4px; background: var(--empty); margin-top: 8px; }
  .theme__bar span { display: block; height: 100%; background: var(--brand); }

  @media (max-width: 860px) {
    .themes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 40px; }
    .scoreboard { padding: 20px 16px; }
    .score__num { font-size: 36px; }
    .scoreboard__nums .label { font-size: 11px; letter-spacing: 0.04em; }
    .book-row { grid-template-columns: 1fr; grid-template-areas: 'meta' 'title' 'author' 'verdict'; }
    .book-row__verdict { margin-top: 10px; }
    .themes { grid-template-columns: 1fr; }
  }
</style>
