---
// Honorable mentions: books that missed a theme's list but earned a nod.
// Source: src/data/honorable-mentions.json. They are not summarized and don't count toward the 365.
import Base from '../layouts/Base.astro';
import mentions from '../data/honorable-mentions.json';
import { themes } from '../lib/books';
import { url } from '../lib/url';

const lanes = { crowd: 'Crowd favorite', specialist: "Specialist's pick" };
const groups = themes
  .map((t) => ({ theme: t, items: mentions.filter((m) => m.theme === t.slug) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Honorable mentions" description="Famous books and panel favorites that didn't make a theme's list, and why.">
  <article class="container page">
    <header>
      <p class="label">Selection</p>
      <h1>Honorable mentions</h1>
      <p class="lead">
        Up to three per theme: books that didn't make the list but deserve a word. A{' '}
        <strong>crowd favorite</strong> is famous and widely read but scored low with the panel. A{' '}
        <strong>specialist's pick</strong> got a 5 from the persona who leads that theme and still lost.
        They aren't summarized and don't count toward the 365.
      </p>
      <p class="note">Scores and reasons are the panel's, which means Claude's judgment. See <a href={url('/how-its-made/')}>how it's made</a>.</p>
    </header>

    {groups.map((g, i) => (
      <section class="section">
        <h2 class="section-header"><span class="num">{String(i + 1).padStart(2, '0')}</span> / {g.theme.name}</h2>
        <ul class="mentions">
          {g.items.map((m) => (
            <li>
              <p class="mention__lane">
                {lanes[m.lane as keyof typeof lanes]}{m.champion && ` · ${m.champion}`} · score {m.final.toFixed(2)}
              </p>
              <h3><em>{m.title}</em></h3>
              <p class="mention__meta">{m.author} · {m.year}</p>
              <p>{m.blurb}</p>
              <p class="mention__why"><strong>Why it missed:</strong> {m.why_not}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Base>

<style>
  .page { padding-top: 48px; }
  .page header .lead { margin-top: 24px; max-width: 760px; }
  .note { color: var(--muted); font-size: 15px; }
  .num { color: var(--text); }
  .mentions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .mentions li { background: var(--bg); padding: 20px; display: grid; gap: 8px; align-content: start; }
  .mentions h3 { margin: 0; font-size: 20px; }
  .mentions p { margin: 0; }
  .mention__lane { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .mention__meta { color: var(--muted); font-size: 15px; }
  .mention__why { font-size: 15px; color: var(--muted); }
  .mention__why strong { color: var(--text); }
  @media (max-width: 900px) { .mentions { grid-template-columns: 1fr; } }
</style>
